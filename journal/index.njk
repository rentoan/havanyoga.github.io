<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Calm, practical HAVAN guides for movement breaks, choosing a starting point and evaluating home movement programs.">
    <title>Journal — HAVAN</title>
    <link rel="canonical" href="https://havan.fit/journal/">
    <link rel="icon" href="/assets/havan-mark.svg" type="image/svg+xml">
    <meta name="theme-color" content="#213128">
    <meta property="og:site_name" content="HAVAN"><meta property="og:type" content="website">
    <meta property="og:title" content="Journal — HAVAN">
    <meta property="og:description" content="Calm, practical guides for making movement fit real life.">
    <meta property="og:url" content="https://havan.fit/journal/">
    <meta property="og:image" content="https://havan.fit/assets/og-havan.webp">
    <meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="Journal — HAVAN"><meta name="twitter:description" content="Calm, practical guides for making movement fit real life."><meta name="twitter:image" content="https://havan.fit/assets/og-havan.webp">
    <link rel="stylesheet" href="/styles.css">
    <script defer src="/app.js"></script>
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"CollectionPage","name":"HAVAN Journal","description":"Calm, practical guides for making movement fit real life.","url":"https://havan.fit/journal/","isPartOf":{"@id":"https://havan.fit/#website"},"inLanguage":"en"}</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {% include "site-header.njk" %}
    <main id="main">
      <header class="archive-hero">
        <p class="eyebrow">HAVAN Journal</p>
        <h1>Useful before impressive.</h1>
        <p>Practical reads to help you choose a small next step, understand your options and spend with more confidence.</p>
      </header>
      <section class="archive-section" aria-labelledby="topics-title">
        <div class="archive-heading">
          <div><p class="eyebrow">Explore by topic</p><h2 id="topics-title">Find the guidance you need.</h2></div>
          <p>Every new article is added to the relevant topic automatically.</p>
        </div>
        <div class="archive-topics">
          {% for topic in topics %}
          {% set topicPosts = collections.journal | filterByTopic(topic.slug) %}
          <a class="archive-topic" href="/journal/{{ topic.slug }}/">
            <span class="archive-count">{{ topicPosts | length }} {% if topicPosts | length == 1 %}article{% else %}articles{% endif %}</span>
            <h3>{{ topic.title }}</h3>
            <p>{{ topic.description }}</p>
            <span class="topic-arrow" aria-hidden="true">→</span>
          </a>
          {% endfor %}
        </div>
      </section>
      <section class="archive-section archive-latest" aria-labelledby="latest-title">
        <div class="archive-heading">
          <div><p class="eyebrow">All articles</p><h2 id="latest-title">The complete Journal.</h2></div>
          <p>{{ collections.journal | length }} practical reads and counting.</p>
        </div>
        <div class="archive-list">
          {% for post in collections.journal %}
          <article class="archive-card">
            <p class="meta">{{ post.data.readingTime }} · {{ post.data.contentType }}</p>
            <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
            <p>{{ post.data.summary }}</p>
            <a class="text-link" href="{{ post.url }}">Read article</a>
          </article>
          {% endfor %}
        </div>
      </section>
    </main>
    {% include "site-footer.njk" %}
  </body>
</html>
