---
pagination:
  data: topics
  size: 1
  alias: topic
  addAllPagesToCollections: true
permalink: "journal/{{ topic.slug }}/index.html"
---
{% set topicPosts = collections.journal | filterByTopic(topic.slug) %}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="{{ topic.description }} Read every {{ topic.title | lower }} article from HAVAN.">
    <title>{{ topic.title }} — HAVAN Journal</title>
    <link rel="canonical" href="https://havan.fit/journal/{{ topic.slug }}/">
    <link rel="icon" href="/assets/havan-mark.svg" type="image/svg+xml">
    <meta name="theme-color" content="#213128">
    <meta property="og:site_name" content="HAVAN"><meta property="og:type" content="website">
    <meta property="og:title" content="{{ topic.title }} — HAVAN Journal">
    <meta property="og:description" content="{{ topic.description }}">
    <meta property="og:url" content="https://havan.fit/journal/{{ topic.slug }}/">
    <meta property="og:image" content="https://havan.fit/assets/og-havan.webp">
    <meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="{{ topic.title }} — HAVAN Journal"><meta name="twitter:description" content="{{ topic.description }}"><meta name="twitter:image" content="https://havan.fit/assets/og-havan.webp">
    <link rel="stylesheet" href="/styles.css">
    <script defer src="/app.js"></script>
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"CollectionPage","name":"{{ topic.title }} — HAVAN Journal","description":"{{ topic.description }}","url":"https://havan.fit/journal/{{ topic.slug }}/","isPartOf":{"@id":"https://havan.fit/#website"},"inLanguage":"en"}</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {% include "site-header.njk" %}
    <main id="main">
      <header class="archive-hero archive-topic-hero">
        <p><a class="text-link" href="/journal/">Journal</a> / Topic</p>
        <p class="eyebrow">{{ topicPosts | length }} {% if topicPosts | length == 1 %}article{% else %}articles{% endif %}</p>
        <h1>{{ topic.title }}</h1>
        <p>{{ topic.description }}</p>
      </header>
      <section class="archive-section archive-latest" aria-label="{{ topic.title }} articles">
        <div class="archive-list">
          {% for post in topicPosts %}
          <article class="archive-card">
            <p class="meta">{{ post.data.readingTime }} · {{ post.data.contentType }}</p>
            <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
            <p>{{ post.data.summary }}</p>
            <a class="text-link" href="{{ post.url }}">Read article</a>
          </article>
          {% endfor %}
        </div>
      </section>
    </main>
    {% include "site-footer.njk" %}
  </body>
</html>
